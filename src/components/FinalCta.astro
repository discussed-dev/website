---
import InstallLinks from "./InstallLinks.astro";
---

<section class="border-t border-[color:var(--border)] py-16 sm:py-20">
  <div class="shell grid gap-8 sm:grid-cols-[1fr_auto] sm:items-end">
    <div>
      <h2
        class="font-[family-name:var(--font-serif)] text-[2rem] font-normal text-[color:var(--text)]"
      >
        Install Discussed
      </h2>
      <p
        class="mt-3 max-w-xl text-[0.95rem] leading-7 text-[color:var(--text-muted)]"
      >
        Add Discussed from the Chrome or Firefox store. Edge currently uses the
        manual 0.3.8 ZIP package.
      </p>
    </div>
    <InstallLinks className="sm:justify-end" />
  </div>
</section>
