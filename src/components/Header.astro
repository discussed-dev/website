<header class="py-4">
  <div class="shell">
    <div class="flex items-center justify-between">
      <a
        href="/"
        class="inline-flex items-center gap-2.5 no-underline"
        aria-label="Discussed home"
      >
        <img
          src="/brand/discussed-mark-brand.svg"
          alt=""
          width="40"
          height="40"
          loading="eager"
          decoding="sync"
          class="size-10"
        />
        <span
          class="text-xl font-semibold tracking-[-0.035em] text-[color:var(--text)] sm:text-2xl"
          >Discussed</span
        >
      </a>
      <nav
        class="flex gap-5 text-[0.875rem] text-[color:var(--text-muted)] sm:gap-6"
      >
        <a
          href="/privacy"
          class="no-underline transition-colors hover:text-[color:var(--text)]"
          >Privacy</a
        >
        <a
          href="https://github.com/discussed-dev/extension"
          class="no-underline transition-colors hover:text-[color:var(--text)]"
          >GitHub</a
        >
      </nav>
    </div>
  </div>
</header>
