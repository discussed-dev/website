---
const steps = [
  {
    num: "01",
    title: "Browse normally",
    description:
      "The toolbar badge shows how many matching discussions were found for the current page.",
  },
  {
    num: "02",
    title: "Open the threads",
    description:
      "The popup groups Hacker News, Reddit, and Lobsters threads and sorts them by comment count.",
  },
  {
    num: "03",
    title: "Summarize when needed",
    description:
      "Summarize the collected threads with your chosen LLM and API key.",
  },
];
---

<section class="py-16 sm:py-20">
  <div class="shell">
    <h2
      class="font-[family-name:var(--font-serif)] text-[2rem] font-normal text-[color:var(--text)]"
    >
      How Discussed works
    </h2>
    <div class="mt-12 grid gap-10 sm:grid-cols-3">
      {
        steps.map((step) => (
          <div>
            <p class="text-[0.75rem] font-semibold text-[color:var(--accent)]">
              {step.num}
            </p>
            <h3 class="mt-3 text-[1.05rem] font-semibold text-[color:var(--text)]">
              {step.title}
            </h3>
            <p class="mt-2 text-[0.9rem] leading-[1.65] text-[color:var(--text-muted)]">
              {step.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
