---
const steps = [
  {
    num: "01",
    title: "Browse normally",
    description:
      "The toolbar badge shows how many matching discussions were found for the current page.",
  },
  {
    num: "02",
    title: "Open the threads",
    description:
      "The popup groups Hacker News, Reddit, and Lobsters threads and sorts them by comment count.",
  },
  {
    num: "03",
    title: "Summarize when needed",
    description:
      "Summarize the collected threads with your chosen LLM and API key.",
  },
];
---

<section class="border-y border-[color:var(--border)] py-16 sm:py-20">
  <div
    class="shell grid gap-10 lg:grid-cols-[minmax(13rem,0.65fr)_minmax(0,1.35fr)] lg:gap-16"
  >
    <div>
      <h2
        class="font-[family-name:var(--font-serif)] text-[2rem] font-normal text-[color:var(--text)]"
      >
        How Discussed works
      </h2>
      <p
        class="mt-4 max-w-xs text-[0.9rem] leading-[1.65] text-[color:var(--text-muted)]"
      >
        The extension stays out of the way until a page has discussions worth
        opening.
      </p>
    </div>
    <ol class="m-0 list-none border-t border-[color:var(--border)] p-0">
      {
        steps.map((step) => (
          <li class="grid gap-x-6 gap-y-2 border-b border-[color:var(--border)] py-6 sm:grid-cols-[2.5rem_10rem_minmax(0,1fr)] sm:items-baseline">
            <span class="text-[0.75rem] font-semibold text-[color:var(--accent)]">
              {step.num}
            </span>
            <h3 class="text-[1.05rem] font-semibold text-[color:var(--text)]">
              {step.title}
            </h3>
            <p class="col-start-1 mt-0 text-[0.9rem] leading-[1.65] text-[color:var(--text-muted)] sm:col-start-auto">
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
