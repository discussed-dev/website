---
const features = [
  {
    name: "Tracking parameters stripped",
    desc: "URLs are cleaned of utm_* and similar tags before any search",
  },
  {
    name: "Three discussion sources",
    desc: "Hacker News, Reddit, and Lobsters in one popup",
  },
  {
    name: "Optional summaries",
    desc: "Cross-thread summaries through your chosen LLM provider",
  },
  {
    name: "No Discussed backend",
    desc: "Requests go directly from your browser to the selected services",
  },
  {
    name: "MIT licensed",
    desc: "Read the source, report issues, or contribute",
  },
];
---

<section class="py-16 sm:py-20">
  <div class="shell">
    <div
      class="grid gap-8 lg:grid-cols-[minmax(13rem,0.65fr)_minmax(0,1.35fr)] lg:gap-16"
    >
      <div>
        <h2
          class="font-[family-name:var(--font-serif)] text-[2rem] font-normal text-[color:var(--text)]"
        >
          Under the hood
        </h2>
        <p
          class="mt-4 max-w-xs text-[0.9rem] leading-[1.65] text-[color:var(--text-muted)]"
        >
          Direct browser requests, open source code, and no Discussed account or
          backend.
        </p>
      </div>
      <ul class="m-0 list-none p-0">
        {
          features.map((f) => (
            <li class="flex flex-col gap-1 border-b border-[color:var(--border)] py-4 first:border-t sm:flex-row sm:items-baseline sm:justify-between sm:gap-8">
              <span class="text-[0.95rem] font-semibold text-[color:var(--text)]">
                {f.name}
              </span>
              <span class="text-[0.85rem] text-[color:var(--text-muted)] sm:text-right">
                {f.desc}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
