---
// Spot illustrations drawn with the project's spotkit skill. They are inlined
// so the --il-* tokens in global.css theme them, and hidden from assistive
// technology because each one repeats the text beside it.
import tracking from "../assets/feature-spots/tracking.svg?raw";
import sources from "../assets/feature-spots/sources.svg?raw";
import summaries from "../assets/feature-spots/summaries.svg?raw";
import backend from "../assets/feature-spots/backend.svg?raw";
import mit from "../assets/feature-spots/mit.svg?raw";

const features = [
  {
    name: "Tracking parameters stripped",
    desc: "URLs are cleaned of utm_* and similar tags before any search",
    spot: tracking,
  },
  {
    name: "Three discussion sources",
    desc: "Hacker News, Reddit, and Lobsters in one popup",
    spot: sources,
  },
  {
    name: "Optional summaries",
    desc: "Cross-thread summaries through your chosen LLM provider",
    spot: summaries,
  },
  {
    name: "No Discussed backend",
    desc: "Requests go directly from your browser to the selected services",
    spot: backend,
  },
  {
    name: "MIT licensed",
    desc: "Read the source, report issues, or contribute",
    spot: mit,
  },
];
---

<section class="py-16 sm:py-20">
  <div class="shell">
    <div
      class="grid gap-8 lg:grid-cols-[minmax(13rem,0.65fr)_minmax(0,1.35fr)] lg:gap-16"
    >
      <div>
        <h2
          class="font-[family-name:var(--font-serif)] text-[2rem] font-normal text-[color:var(--text)]"
        >
          Under the hood
        </h2>
        <p
          class="mt-4 max-w-xs text-[0.9rem] leading-[1.65] text-[color:var(--text-muted)]"
        >
          Direct browser requests, open source code, and no Discussed account or
          backend.
        </p>
      </div>
      <ul class="m-0 list-none p-0">
        {
          features.map((f) => (
            <li class="flex items-center gap-5 border-b border-[color:var(--border)] py-3 first:border-t sm:gap-8">
              <div
                class="w-32 shrink-0 [&>svg]:block [&>svg]:h-auto [&>svg]:w-full"
                set:html={f.spot}
              />
              <div class="flex min-w-0 flex-col gap-1">
                <span class="text-[0.95rem] font-semibold text-[color:var(--text)]">
                  {f.name}
                </span>
                <span class="text-[0.85rem] text-[color:var(--text-muted)]">
                  {f.desc}
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
